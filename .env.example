# AegisCart AI — Environment Variables
# All variables are OPTIONAL: the app works out-of-the-box in Zero-Config Sandbox Simulation Mode.

# PayPal Sandbox / Live Credentials (https://developer.paypal.com)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_MERCHANT_ID=

# Channel3 Product Discovery API (https://trychannel3.com/developers)
CHANNEL3_API_KEY=

# LLM Tool Calling (either Gemini or OpenAI; falls back to deterministic orchestrator if unset)
GEMINI_API_KEY=
OPENAI_API_KEY=

# App URL (used for PayPal return/cancel URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

